rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document
    match /test/connection {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'gulizia.i@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidCreation(data) {
      return data.keys().hasAll(['title', 'authorName', 'projectJson', 'reportCount', 'createdAt'])
        && data.keys().size() <= 10
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 50
        && data.projectJson is string && data.projectJson.size() <= 900000
        && (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 150000))
        && (!('deletePasscode' in data) || (data.deletePasscode is string && data.deletePasscode.size() <= 32))
        && (!('likeCount' in data) || (data.likeCount is number && data.likeCount >= 0))
        && (!('featured' in data) || data.featured is bool)
        && (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 16))
        && data.reportCount == 0
        && (data.createdAt is timestamp || data.createdAt == request.time);
    }

    match /creations/{creationId} {
      // Public read access for the community gallery
      allow read: if true;

      // Anyone can share their creation without prior login
      allow create: if isValidId(creationId) && isValidCreation(incoming());

      // Update rules:
      // 1. Report count increment (+1)
      // 2. Like/upvote increment or decrement (+1 or -1)
      // 3. Featured flag toggle (admin)
      // 4. Authenticated admin full update
      allow update: if isValidId(creationId) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['reportCount']) && incoming().reportCount == existing().reportCount + 1) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likeCount']) && (incoming().likeCount == existing().likeCount + 1 || incoming().likeCount == existing().likeCount - 1)) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['featured']) && incoming().featured is bool) ||
        isAdmin()
      );

      // Deletion allowed for validated creation IDs
      allow delete: if isValidId(creationId);
    }
  }
}
